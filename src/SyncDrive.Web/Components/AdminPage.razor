@inject WebTexts T

@* Verwaltung, aus dem Zahnrad über dem Profil: „Organisationseinstellungen“ (Richtlinien, Team-Ordner) oder „Benutzer & Gruppen“. *@
<div class="view">
    <div class="tabs admin-tabs" role="tablist">
        @foreach (var (tab, label) in Tabs)
        {
            <button role="tab" class="tab @(Current == tab ? "active" : "")" aria-selected="@(Current == tab)" @onclick="() => _tab = tab">@label</button>
        }
    </div>
    @switch (Current)
    {
        case Tab.Users:
            <AdminView Me="@Me" Token="Token" />
            break;
        case Tab.Groups:
            <GroupsView Token="Token" />
            break;
        case Tab.SignIn:
            <OAuthView Token="Token" />
            break;
        case Tab.Policies:
            <PoliciesView Token="Token" />
            break;
        default:
            <TeamFoldersView Token="Token" />
            break;
    }
</div>

@code {
    public enum Section
    {
        Organisation,
        People,
    }

    private enum Tab
    {
        Users,
        Groups,
        TeamFolders,
        Policies,
        SignIn,
    }

    private Tab? _tab;

    [Parameter]
    public Section Area { get; set; }

    [Parameter]
    public string? Me { get; set; }

    [Parameter]
    public CancellationToken Token { get; set; }

    /// <summary>Gewählter Reiter, solange er zum Bereich gehört; sonst der erste des Bereichs.</summary>
    private Tab Current => _tab is { } tab && Tabs.Any(t => t.Tab == tab) ? tab : Tabs.First().Tab;

    private IEnumerable<(Tab Tab, string Label)> Tabs => Area == Section.Organisation
        ? [(Tab.Policies, T.PoliciesTab), (Tab.TeamFolders, T.TeamFoldersTab), (Tab.SignIn, T.SignInTab)]
        : [(Tab.Users, T.Users), (Tab.Groups, T.Groups)];
}
