@implements IDisposable
@inject AppsViewModel Apps
@inject NavigationManager Navigation

@* Profilmenü → „Desktop- und Mobil-Apps“: Übersicht mit Bild und zwei Wegen; Desktop führt zum Download, Mobil zeigt einen QR-Code. *@
<div class="backdrop" @onclick="Close">
    <div class="dialog apps-dialog" role="dialog" aria-modal="true" aria-labelledby="apps-title" @onclick:stopPropagation>
        <button class="tool apps-close" title="@T.Close" aria-label="@T.Close" @onclick="Close">✕</button>
        @switch (Apps.Current)
        {
            case AppsViewModel.Page.Overview:
                <svg class="apps-art" viewBox="0 0 480 220" aria-hidden="true">
                    <ellipse cx="250" cy="206" rx="210" ry="9" style="fill: var(--row-hover)" />
                    <rect x="40" y="10" width="300" height="186" rx="10" style="fill: var(--nav); stroke: var(--line)" />
                    <circle cx="56" cy="24" r="3.5" style="fill: var(--line)" />
                    <circle cx="68" cy="24" r="3.5" style="fill: var(--line)" />
                    <circle cx="80" cy="24" r="3.5" style="fill: var(--line)" />
                    <rect x="96" y="18" width="190" height="12" rx="6" style="fill: var(--bg)" />
                    <rect x="48" y="40" width="74" height="148" rx="6" style="fill: var(--bg)" />
                    <rect x="54" y="50" width="62" height="11" rx="3" style="fill: var(--accent-light-2)" />
                    @for (var i = 0; i < 5; i++)
                    {
                        <rect x="60" y="@(74 + i * 16)" width="@(i % 2 == 0 ? 44 : 34)" height="5" rx="2.5" style="fill: var(--line)" />
                    }
                    <g transform="translate(142 54)">
                        <path d="M0 6a4 4 0 0 1 4-4h10l4 5h14a4 4 0 0 1 4 4v19a4 4 0 0 1-4 4H4a4 4 0 0 1-4-4Z" style="fill: var(--filetype-folder)" />
                    </g>
                    <g transform="translate(206 50)"><path d="M3 0h20l9 9v29a3 3 0 0 1-3 3H3a3 3 0 0 1-3-3V3a3 3 0 0 1 3-3Z" style="fill: var(--filetype-doc)" /><path d="M8 18h16M8 24h16M8 30h11" style="stroke: var(--on-accent); stroke-width: 2.2; stroke-linecap: round" /></g>
                    <g transform="translate(268 50)"><path d="M3 0h20l9 9v29a3 3 0 0 1-3 3H3a3 3 0 0 1-3-3V3a3 3 0 0 1 3-3Z" style="fill: var(--filetype-sheet)" /><rect x="8" y="17" width="16" height="14" rx="1.5" style="fill: none; stroke: var(--on-accent); stroke-width: 2" /><path d="M8 24h16M16 17v14" style="stroke: var(--on-accent); stroke-width: 2" /></g>
                    <g transform="translate(144 112)"><path d="M3 0h20l9 9v29a3 3 0 0 1-3 3H3a3 3 0 0 1-3-3V3a3 3 0 0 1 3-3Z" style="fill: var(--filetype-pdf)" /><path d="M9 30c4-3 7-9 8-15 1 6 4 12 8 15" style="fill: none; stroke: var(--on-accent); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round" /></g>
                    <g transform="translate(206 112)"><path d="M3 0h20l9 9v29a3 3 0 0 1-3 3H3a3 3 0 0 1-3-3V3a3 3 0 0 1 3-3Z" style="fill: var(--filetype-image)" /><circle cx="11" cy="17" r="3" style="fill: var(--on-accent)" /><path d="M6 33l7-8 5 5 4-4 5 7Z" style="fill: var(--on-accent)" /></g>
                    <g transform="translate(268 112)"><path d="M3 0h20l9 9v29a3 3 0 0 1-3 3H3a3 3 0 0 1-3-3V3a3 3 0 0 1 3-3Z" style="fill: var(--filetype-slides)" /><rect x="8" y="17" width="16" height="11" rx="1.5" style="fill: none; stroke: var(--on-accent); stroke-width: 2.2" /></g>
                    <circle cx="372" cy="62" r="22" style="fill: var(--accent)" />
                    <path d="M362 58a11 11 0 0 1 19-5M382 66a11 11 0 0 1-19 5" style="fill: none; stroke: var(--on-accent); stroke-width: 3; stroke-linecap: round" />
                    <path d="M383 47v7h-7M361 77v-7h7" style="fill: none; stroke: var(--on-accent); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round" />
                    <rect x="344" y="116" width="84" height="56" rx="5" style="fill: var(--rail)" />
                    <rect x="350" y="122" width="72" height="44" rx="2" style="fill: var(--accent-light)" />
                    <path d="M334 172h104l-8 10h-88Z" style="fill: var(--input-border)" />
                    <rect x="438" y="122" width="32" height="62" rx="6" style="fill: var(--rail)" />
                    <rect x="441" y="129" width="26" height="46" rx="2" style="fill: var(--accent-light)" />
                </svg>
                <h2 id="apps-title" class="apps-title">@T.AppsTitle</h2>
                <p class="apps-text">@T.AppsText</p>
                <div class="apps-buttons">
                    <button class="primary" @onclick="Apps.ShowDesktop">@T.ForDesktop</button>
                    <button class="primary" @onclick="Apps.ShowMobile">@T.ForMobile</button>
                </div>
                break;
            case AppsViewModel.Page.Desktop:
                <h2 id="apps-title" class="apps-title">@T.DesktopTitle</h2>
                <p class="apps-text">@T.DesktopText</p>
                <div class="apps-buttons">
                    <button @onclick="Apps.Back">@T.Back</button>
                    @if (Apps.DesktopUrl is { } url)
                    {
                        <a class="button primary" href="@url" target="_blank" rel="noopener noreferrer">@T.Download</a>
                    }
                </div>
                break;
            case AppsViewModel.Page.Mobile:
                <h2 id="apps-title" class="apps-title">@T.MobileTitle</h2>
                <img class="apps-qr" src="@Apps.QrCode" alt="@Apps.WebAddress" width="200" height="200" />
                <p class="apps-address">@Apps.WebAddress</p>
                <p class="apps-text">@T.MobileText</p>
                <div class="apps-buttons">
                    <button @onclick="Apps.Back">@T.Back</button>
                </div>
                break;
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public CancellationToken Token { get; set; }

    private WebTexts T => Apps.Texts;

    protected override async Task OnInitializedAsync()
    {
        Apps.Changed += Refresh;
        await Apps.OpenAsync(Navigation.BaseUri, Token);
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private Task Close() => OnClose.InvokeAsync();

    public void Dispose() => Apps.Changed -= Refresh;
}
