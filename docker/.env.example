# Copy to .env and adjust.

# Host name clients use to reach the server; Caddy issues the TLS certificate for it.
SYNCDRIVE_HOST=drive.example.lan

# Time zone of the server (backup time, log timestamps).
TZ=Europe/Berlin

# Time of the nightly backup (HH:mm, in TZ).
SYNCDRIVE_BACKUP_TIME=02:30

# Image tag on Docker Hub: "latest" or a fixed version such as 0.18.3.
SYNCDRIVE_VERSION=latest
