@* Gefüllte Symbole (24×24, eigene Pfade) für Symbolleiste, Seitenleiste und Menüs; Farbe aus currentColor. *@
@if (Name is "share" or "link")
{
    @* Kettenglied (Teilen, Link): zwei offene Glieder mit Steg, schräg; als Linie gleicher Stärke, damit es auch klein scharf bleibt *@
    <svg class="icon @Class" viewBox="0 0 24 24" aria-hidden="true">
        <g transform="rotate(-45 12 12)" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9.6 7.6H7.2a4.4 4.4 0 0 0 0 8.8h2.4M14.4 7.6h2.4a4.4 4.4 0 0 1 0 8.8h-2.4M8.6 12h6.8" />
        </g>
    </svg>
}
else
{
    <svg class="icon @Class" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="@PathOf(Name)" /></svg>
}

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string? Class { get; set; }

