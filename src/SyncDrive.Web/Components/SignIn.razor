@inject SessionViewModel Session

@* Anmeldeseite: mittig Logo und eine halbtransparente Karte („Bei <Server> anmelden“) mit Name, Passwort und einer breiten
   Schaltfläche; darunter der Text des Administrators. Hintergrund: das Bild des Administrators oder ein eigener Verlauf. *@
<div class="portal @(Session.Portal.BackgroundUrl is null ? "portal-default" : "")" style="@BackgroundStyle">
    <main class="portal-column">
        <div class="portal-logo"><Logo Size="72" /></div>

        <form class="portal-card" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
            <h1 class="portal-title">@string.Format(CultureInfo.CurrentCulture, T.SignInTo, Session.Portal.ServerName)</h1>

            <label class="portal-field">
                <span>@T.UserName</span>
                <input @ref="_userField" @bind="_user" autocomplete="username" disabled="@Session.IsBusy" />
            </label>
            <label class="portal-field">
                <span>@T.Password</span>
                <input @bind="_password" type="password" autocomplete="current-password" disabled="@Session.IsBusy" />
            </label>

            @if (Session.Error is { } error)
            {
                <div class="portal-error" role="alert">@error</div>
            }

            <button type="submit" class="portal-submit" disabled="@Session.IsBusy">
                <span>@T.SignInButton</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
        </form>

        @if (Session.Portal.LoginMessage is { } message)
        {
            <p class="portal-message">@message</p>
        }
    </main>
    <footer class="portal-footer">@T.SignInTagline</footer>
</div>

@code {
    private ElementReference _userField;
    private string _user = string.Empty;
    private string _password = string.Empty;

    private WebTexts T => Session.Texts;

    private string? BackgroundStyle => Session.Portal.BackgroundUrl is { } url ? $"background-image:url('{url}')" : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _userField.FocusAsync();
        }
    }

    private async Task SubmitAsync()
    {
        if (!await Session.SignInAsync(_user, _password, CancellationToken.None))
        {
            _password = string.Empty; // nie im Formular stehen lassen
        }
    }
}
