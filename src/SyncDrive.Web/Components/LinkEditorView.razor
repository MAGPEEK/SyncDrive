@* Ein Link im Freigabedialog schrittweise freigeschaltet: Felder sind ausgegraut statt versteckt, bis der Link an ist. *@
<div class="link-editor">
    <label class="check-row">
        <input type="checkbox" checked="@Editor.Enabled" disabled="@Disabled" @onchange="e => Editor.Enabled = (bool)e.Value!" />
        <span>@Title</span>
    </label>
    <p class="sub">@Hint</p>
    <div class="link-options @(Editor.Enabled ? "" : "off")">
        <label class="check-row">
            <input type="checkbox" checked="@Editor.UsePassword" disabled="@(Disabled || !Editor.Enabled || Editor.PasswordRequired)"
                   @onchange="e => Editor.UsePassword = (bool)e.Value!" />
            <span>@Texts.PasswordProtect@(Editor.PasswordRequired ? $" ({Texts.PolicyEnforced})" : string.Empty)</span>
        </label>
        <input type="password" class="indented" autocomplete="new-password" disabled="@(Disabled || !Editor.Enabled || !Editor.UsePassword)"
               @bind="Editor.Password" @bind:event="oninput" aria-label="@Texts.Password" />
        @if (Editor.Link?.HasPassword == true && Editor.UsePassword)
        {
            <span class="sub indented">@Texts.PasswordKept</span>
        }
        <label class="check-row">
            <input type="checkbox" checked="@Editor.UseExpiry" disabled="@(Disabled || !Editor.Enabled || Editor.MaxDays is not null)"
                   @onchange="e => Editor.UseExpiry = (bool)e.Value!" />
            <span>@Texts.ExpiryDate@(Editor.MaxDays is { } days ? $" (max. {days}, {Texts.PolicyEnforced})" : string.Empty)</span>
        </label>
        <input type="date" class="indented" disabled="@(Disabled || !Editor.Enabled || !Editor.UseExpiry)"
               max="@Editor.LatestDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
               @bind="Editor.ExpiryDate" @bind:format="yyyy-MM-dd" aria-label="@Texts.ExpiryDate" />
        @if (Url is { } url)
        {
            <div class="link-field">
                <input readonly value="@url" aria-label="@Title" />
                <button type="button" class="copy-icon" title="@Texts.CopyLink" aria-label="@Texts.CopyLink" @onclick="() => OnCopy.InvokeAsync(url)">⧉</button>
            </div>
        }
    </div>
</div>

@code {
    [Inject]
    private WebTexts Texts { get; set; } = null!;

    [Parameter, EditorRequired]
    public LinkEditor Editor { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Hint { get; set; } = string.Empty;

    /// <summary>Adresse des gespeicherten Links; null, solange es keinen gibt.</summary>
    [Parameter]
    public string? Url { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<string> OnCopy { get; set; }
}
