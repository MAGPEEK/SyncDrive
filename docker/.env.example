# Copy to .env and adjust.

# Port on the host; the application listens on 8080 inside the container.
SYNCDRIVE_PORT=8080

# Administrator, created on the first start only (when no user exists yet).
SYNCDRIVE_ADMIN_USER=admin
SYNCDRIVE_ADMIN_PASSWORD=change-me-to-a-long-password

# Time zone of the server (backup time, log timestamps).
TZ=Europe/Berlin

# Time of the nightly backup (HH:mm, in TZ).
SYNCDRIVE_BACKUP_TIME=02:30

# Image tag on Docker Hub: "latest" or a fixed version such as 0.18.5.
SYNCDRIVE_VERSION=latest
