# Zeilenenden fest je Dateityp, unabhängig vom Betriebssystem des Checkouts (CI läuft auf Linux und Windows).
* text=auto
*.cs text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.sln text eol=crlf
.editorconfig text eol=crlf
*.md text eol=crlf
*.sql text eol=crlf
*.txt text eol=crlf
# Container und CI brauchen LF
Dockerfile text eol=lf
.dockerignore text eol=lf
Caddyfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.png binary
*.ico binary
*.jpg binary
*.rtf text eol=crlf
*.ps1 text eol=crlf
*.wxs text eol=crlf
*.wixproj text eol=crlf
*.razor text eol=crlf
*.css text eol=crlf
