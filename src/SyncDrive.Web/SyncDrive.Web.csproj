<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Dünne Ansicht der Weboberfläche (ADR-11); Logik liegt in SyncDrive.Web.App. Der Server-Host liefert die gebauten Dateien aus. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SyncDrive.Web.App\SyncDrive.Web.App.csproj" />
  </ItemGroup>

</Project>
