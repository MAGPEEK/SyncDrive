        "delete" => "M9 2.5h6l1 1.5h4.5v2.5h-17V4H8zM5 8h14l-1.1 12.2A2 2 0 0 1 15.9 22H8.1a2 2 0 0 1-2-1.8zM9 10.5v8.5h2v-8.5zm4 0v8.5h2v-8.5z",
