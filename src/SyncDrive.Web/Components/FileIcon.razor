@* Dateiart-Symbol wie in den Listen des Desktop-Clients: Ordner gelb, Dateien mit einer Farbe je Art (Tokens filetype-*). *@
@if (Folder)
{
    <svg class="file-icon @(Large ? "large" : "")" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M2 6.5A1.5 1.5 0 0 1 3.5 5h5l2 2h10A1.5 1.5 0 0 1 22 8.5v10a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5z" style="fill: var(--filetype-folder)" />
        <path d="M2 9h20v9.5a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5z" style="fill: var(--filetype-folder-front)" />
    </svg>
}
else
{
    <svg class="file-icon @(Large ? "large" : "")" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 2h9l5 5v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z" style="fill: @Color" />
        <path d="M14 2v5h5" style="fill: var(--on-accent)" opacity="0.55" />
    </svg>
}

@code {
    [Parameter]
    public bool Folder { get; set; }

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public bool Large { get; set; }

    private string Color => System.IO.Path.GetExtension(Name).ToUpperInvariant() switch
    {
        ".DOC" or ".DOCX" or ".ODT" or ".RTF" or ".TXT" or ".MD" => "var(--filetype-doc)",
        ".XLS" or ".XLSX" or ".ODS" or ".CSV" => "var(--filetype-sheet)",
        ".PPT" or ".PPTX" or ".ODP" => "var(--filetype-slides)",
        ".PDF" => "var(--filetype-pdf)",
        ".JPG" or ".JPEG" or ".PNG" or ".GIF" or ".BMP" or ".HEIC" or ".WEBP" or ".SVG" => "var(--filetype-image)",
        ".MP3" or ".WAV" or ".FLAC" or ".M4A" or ".OGG" => "var(--filetype-audio)",
        ".MP4" or ".MOV" or ".MKV" or ".AVI" or ".WEBM" => "var(--filetype-video)",
        ".ZIP" or ".7Z" or ".RAR" or ".TAR" or ".GZ" or ".ISO" => "var(--filetype-archive)",
        _ => "var(--filetype-other)",
    };
}
