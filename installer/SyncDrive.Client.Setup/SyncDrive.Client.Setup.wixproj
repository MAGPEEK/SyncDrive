<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- Setup-Programm (.exe) mit der MSI darin, für alle, die lieber eine .exe starten. Erwartet die fertige MSI in $(MsiPath). -->
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>SyncDrive-Client-Setup</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>ProductVersion=$(Version);MsiPath=$(MsiPath);Assets=$(MSBuildThisFileDirectory)..\assets;AppIcon=$(MSBuildThisFileDirectory)..\..\src\SyncDrive.Client.Tray\Assets\syncdrive.ico</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
  </ItemGroup>

  <!--
    Signieren mit sign.ps1, sobald SYNCDRIVE_SIGNING_ACCOUNT gesetzt ist: WiX löst die Burn-Engine heraus (SignBundleEngine), setzt sie
    signiert wieder ein und lässt dann das fertige Setup signieren (SignBundle).
  -->
  <PropertyGroup>
    <SignOutput Condition=" '$(SYNCDRIVE_SIGNING_ACCOUNT)' != '' ">true</SignOutput>
    <SignScript>$(MSBuildThisFileDirectory)..\sign.ps1</SignScript>
  </PropertyGroup>

  <Target Name="SignBundleEngine">
    <Exec Command="pwsh -NoProfile -File &quot;$(SignScript)&quot; -Path &quot;%(SignBundleEngine.FullPath)&quot;" />
  </Target>

  <Target Name="SignBundle">
    <Exec Command="pwsh -NoProfile -File &quot;$(SignScript)&quot; -Path &quot;%(SignBundle.FullPath)&quot;" />
  </Target>

</Project>
