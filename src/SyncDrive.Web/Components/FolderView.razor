@implements IDisposable
@inject BrowserViewModel Browser
@inject MarksViewModel Marks
@inject IJSRuntime Js
@inject ViewerViewModel Viewer
@inject FolderPickerViewModel Picker

@* Ordneransicht („My Drive“ und geteilte Spaces): Symbolleiste, Liste mit Auswahl, Kontextmenü, Dialoge, Hochladen. Logik im BrowserViewModel. *@
<div class="view" @onclick="CloseMenus" @onkeydown="CreateKeyAsync">
    <div class="toolbar">
        <div class="create-wrap">
            <button class="primary" disabled="@(!Browser.CanWrite)" @onclick="ToggleCreate" @onclick:stopPropagation>＋ @T.Create</button>
            @if (_createOpen)
            {
                @* Wie in Google Drive: Neuer Ordner, Dateien hochladen, Ordner hochladen; Alt+C öffnet, F/U/I wählt. Die Einträge zum
                   Hochladen sind Labels der dauerhaften Dateifelder unten (ein Feld im Menü verschwände mit dem Menü). *@
                <div class="menu create-menu" @onclick:stopPropagation>
                    <button class="menu-item" @onclick="() => OpenDialog(Dialog.NewFolder)">
                        <svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h5l2 2h8A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5zm9 3.5v2.25H9.75v1.5H12V16h1.5v-2.25h2.25v-1.5H13.5V10z" /></svg>
                        <span class="menu-label">@T.NewFolder</span><span class="menu-shortcut">@Shortcut("F")</span>
                    </button>
                    <div class="menu-line"></div>
                    <label class="menu-item" for="@FilesInputId" @onclick="CloseMenus">
                        <svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h8l5 5v13.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 20.5v-17A1.5 1.5 0 0 1 6.5 2zm7 1.5V8h4.5zM12 10.5l-3.5 3.5 1.06 1.06 1.69-1.69V18h1.5v-4.63l1.69 1.69L15.5 14z" /></svg>
                        <span class="menu-label">@T.UploadFiles</span><span class="menu-shortcut">@Shortcut("U")</span>
                    </label>
                    <label class="menu-item" for="@FolderInputId" @onclick="CloseMenus">
                        <svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h5l2 2h8A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5zM12 9.5l-3.5 3.5 1.06 1.06 1.69-1.69V17h1.5v-4.63l1.69 1.69L15.5 13z" /></svg>
                        <span class="menu-label">@T.UploadFolder</span><span class="menu-shortcut">@Shortcut("I")</span>
                    </label>
                </div>
            }
        </div>
        <InputFile id="@FilesInputId" OnChange="UploadAsync" multiple disabled="@(!Browser.CanWrite)" class="hidden-input" />
        <InputFile @ref="_folderInput" id="@FolderInputId" OnChange="UploadFolderAsync" multiple webkitdirectory disabled="@(!Browser.CanWrite)" class="hidden-input" />
        @* Nur Symbole in runden Knöpfen; was ein Knopf tut, steht beim Darüberfahren darunter (data-tip, CSS). *@
        <div class="icon-bar">
            <label class="icon-button @(Browser.CanWrite ? "" : "disabled")" for="@FilesInputId" data-tip="@T.UploadFiles" aria-label="@T.UploadFiles"><Icon Name="upload" /></label>
            @if (Browser.SelectionDownloadUrl is { } download)
            {
                <a class="icon-button" href="@download" download="@Browser.SelectionDownloadName" data-tip="@T.Download" aria-label="@T.Download"><Icon Name="download" /></a>
            }
            else
            {
                <span class="icon-button disabled" data-tip="@T.Download" aria-label="@T.Download"><Icon Name="download" /></span>
            }
            @if (Browser.CanShare)
            {
                <button class="icon-button" disabled="@(Browser.SelectedItems is not [_])" data-tip="@T.Share" aria-label="@T.Share"
                        @onclick="() => ShareAsync(OnShare, Browser.SelectedItems[0])"><Icon Name="share" /></button>
            }
            <div class="create-wrap">
                <button class="icon-button" disabled="@(Browser.Selected.Count == 0)" data-tip="@T.Labels" aria-label="@T.Labels"
                        @onclick="ToggleLabels" @onclick:stopPropagation><Icon Name="label" /></button>
                @if (_labelsOpen)
                {
                    <LabelMenu Class="create-menu" Items="Browser.SelectedLocated" Token="Token" OnNewLabel="NewLabelAsync" OnDone="CloseMenus" />
                }
            </div>
            <button class="icon-button" disabled="@(!Browser.CanWrite || Browser.Selected.Count == 0)" data-tip="@T.CopyTo" aria-label="@T.CopyTo"
                    @onclick="() => OpenPickerAsync(move: false)"><Icon Name="copy" /></button>
            <button class="icon-button" disabled="@(!Browser.CanWrite || Browser.Selected.Count == 0)" data-tip="@T.Delete" aria-label="@T.Delete"
                    @onclick="() => OpenDialog(Dialog.Delete)"><Icon Name="delete" /></button>
            <div class="create-wrap">
                <button class="icon-button" disabled="@(Browser.Selected.Count == 0)" data-tip="@T.MoreActions" aria-label="@T.MoreActions"
                        aria-expanded="@(_moreOpen ? "true" : "false")" @onclick="ToggleMore" @onclick:stopPropagation><Icon Name="more" /></button>
                @if (_moreOpen && Browser.SelectedItems is [var first, ..])
                {
                    var single = Browser.SelectedItems.Count == 1;
                    <div class="menu create-menu more-menu" role="menu" @onclick:stopPropagation>
                        @if (single && !first.IsFolder && ViewerViewModel.KindOf(first) != ViewerKind.None)
                        {
                            <button class="menu-item" @onclick="() => OpenItemAsync(first)">@T.Preview</button>
                        }
                        @if (single && Browser.ViewUrl(first) is { } tabUrl)
                        {
                            <a class="menu-item" href="@tabUrl" target="_blank" rel="noopener noreferrer" @onclick="CloseMenus">@T.OpenInNewTab</a>
                        }
                        @if (Browser.CanWrite)
                        {
                            <div class="menu-line"></div>
                            <button class="menu-item" @onclick="() => OpenPickerAsync(move: false)">@T.CopyTo</button>
                            <button class="menu-item" @onclick="() => OpenPickerAsync(move: true)">@T.MoveTo</button>
                            <button class="menu-item" disabled="@(!single)" @onclick="() => OpenDialog(Dialog.Rename)">@T.Rename</button>
                        }
                        <div class="menu-line"></div>
                        <button class="menu-item" @onclick="ToggleSelectionStarAsync">@(Marks.AllStarred(Browser.SelectedLocated) ? T.RemoveStar : T.AddStar)</button>
                        <div class="menu-line"></div>
                        <button class="menu-item" disabled="@(!single)" @onclick="() => ShowInfo(first)">@T.Information</button>
                        @if (!first.IsFolder)
                        {
                            <button class="menu-item" disabled="@(!single)" @onclick="() => ShowVersionsAsync(first)">@T.VersionHistory</button>
                        }
                        @if (Browser.SelectionDownloadUrl is { } moreDownload)
                        {
                            <a class="menu-item" href="@moreDownload" download="@Browser.SelectionDownloadName" @onclick="CloseMenus">@T.Download</a>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="toolbar-fill"></div>
        @if (Browser.Selected.Count > 0)
        {
            <span class="selected-count">@string.Format(CultureInfo.CurrentCulture, T.SelectedCount, Browser.Selected.Count)</span>
        }
    </div>

    @* Ablegen: der Rahmen scrollt nicht, die Ablagefläche liegt daher immer über dem sichtbaren Teil der Liste. dragover/drop ohne Ziel
       an der Liste abfangen (nicht am Rahmen: das Dateifeld darin muss den Drop bekommen), sonst öffnet der Browser die Datei selbst. *@
    <div class="list-wrap" @ondragenter="DragEnter" @ondragenter:preventDefault>
    <div class="list" tabindex="0" @ref="_list" @onkeydown="KeyAsync" @ondragover:preventDefault @ondrop:preventDefault>
        <div class="row head">
            <button class="col-title sort" @onclick="() => Browser.SortBy(SortColumn.Name)">@T.Title @Arrow(SortColumn.Name)</button>
            <span class="col-labels sort">@T.Labels</span>
            <button class="col-time sort" @onclick="() => Browser.SortBy(SortColumn.Modified)">@T.ModifiedTime @Arrow(SortColumn.Modified)</button>
            <button class="col-size sort" @onclick="() => Browser.SortBy(SortColumn.Size)">@T.Size @Arrow(SortColumn.Size)</button>
        </div>

        @switch (Browser.State)
        {
            case ListState.Loading:
                <div class="list-note">@T.Loading</div>
                break;
            case ListState.Empty:
                <div class="list-empty">
                    <FileIcon Folder="true" Name="" Large="true" />
                    <p>@T.EmptyFolder</p>
                </div>
                break;
            default:
                @foreach (var item in Browser.Items)
                {
                    <div class="row item @(Browser.Selected.Contains(item.Path) ? "selected" : "")"
                         @onclick="e => Browser.Select(item, e.CtrlKey || e.MetaKey, e.ShiftKey)"
                         @ondblclick="() => OpenItemAsync(item)"
                         @oncontextmenu="e => ShowContextMenu(e, item)" @oncontextmenu:preventDefault>
                        <span class="col-title">
                            <Star Starred="Marks.IsStarred(Browser.Space!, item)" OnToggle="() => StarAsync(item)" />
                            @if (Browser.ThumbnailUrl(item) is { } thumbnail)
                            {
                                <img class="thumb" src="@thumbnail" alt="" loading="lazy" @onerror="() => Browser.ThumbnailFailed(thumbnail)" />
                            }
                            else
                            {
                                <FileIcon Folder="item.IsFolder" Name="@item.Name" />
                            }
                            <span class="name">@item.Name</span>
                        </span>
                        <span class="col-labels">
                            @foreach (var label in Marks.LabelsOf(Browser.Space!, item))
                            {
                                <span class="chip" style="--chip:@label.Color">@label.Name</span>
                            }
                        </span>
                        <span class="col-time">@item.Modified.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</span>
                        <span class="col-size">@(item.IsFolder ? "—" : WebTexts.FormatSize(item.Size))</span>
                    </div>
                }
                break;
        }

    </div>
    @if (_dragging && Browser.CanWrite)
    {
        @* Das unsichtbare Dateifeld liegt obenauf und nimmt die Dateien an; nur sein dragleave heißt „Fläche verlassen“ (das der Fläche
           selbst käme schon beim Wechsel auf das Feld). *@
        <div class="drop-zone">
            <InputFile OnChange="UploadAsync" multiple class="drop-input" @ondragleave="() => _dragging = false" />
            <div class="drop-text">⤒ @T.DropHere</div>
        </div>
    }
    </div>

    @if (_contextItem is { } context)
    {
        <div class="menu context-menu" style="left:@(_menuX)px;top:@(_menuY)px" @onclick:stopPropagation>
            <button class="menu-item" @onclick="() => OpenItemAsync(context)">@T.Open</button>
            @if (Browser.CanShare)
            {
                <div class="menu-line"></div>
                <button class="menu-item" disabled="@(Browser.Selected.Count != 1)" @onclick="() => ShareAsync(OnShare, context)">@T.Share …</button>
                @if (context.IsFolder && Browser.Policies.FileRequests)
                {
                    <button class="menu-item" disabled="@(Browser.Selected.Count != 1)" @onclick="() => ShareAsync(OnRequestFiles, context)">@T.RequestFiles …</button>
                }
            }
            @if (Browser.CanWrite)
            {
                <div class="menu-line"></div>
                <button class="menu-item" disabled="@(Browser.Selected.Count != 1)" @onclick="() => OpenDialog(Dialog.Rename)">@T.Rename</button>
                <button class="menu-item" @onclick="() => OpenPickerAsync(move: false)">@T.CopyTo</button>
                <button class="menu-item" @onclick="() => OpenPickerAsync(move: true)">@T.MoveTo</button>
            }
            <button class="menu-item" disabled="@(Browser.Selected.Count != 1)" @onclick="() => ShowInfo(context)">@T.Information</button>
            <div class="menu-line"></div>
            <button class="menu-item" @onclick="ToggleSelectionStarAsync">@(Marks.AllStarred(Browser.SelectedLocated) ? T.RemoveStar : T.AddStar)</button>
            <div class="submenu-wrap">
                <button class="menu-item" @onclick="() => _contextLabels = !_contextLabels">@T.Labels <span class="submenu-arrow">›</span></button>
                @if (_contextLabels)
                {
                    <LabelMenu Class="submenu" Items="Browser.SelectedLocated" Token="Token" OnNewLabel="NewLabelAsync" OnDone="CloseMenus" />
                }
            </div>
            <div class="menu-line"></div>
            @if (!context.IsFolder)
            {
                <button class="menu-item" disabled="@(Browser.Selected.Count != 1)" @onclick="() => ShowVersionsAsync(context)">@T.Versions</button>
            }
            @if (Browser.SelectionDownloadUrl is { } contextDownload)
            {
                <a class="menu-item" href="@contextDownload" download="@Browser.SelectionDownloadName" @onclick="CloseMenus">@T.Download</a>
            }
            @if (Browser.CanWrite)
            {
                <div class="menu-line"></div>
                <button class="menu-item danger" @onclick="() => OpenDialog(Dialog.Delete)">@T.Delete</button>
            }
        </div>
    }

    @if (Picker.IsOpen)
    {
        @* Zielordner für Kopieren/Verschieben: Pfadleiste oben, darunter die Unterordner zum Betreten *@
        <div class="backdrop" @onclick="Picker.Close">
            <div class="dialog picker-dialog" role="dialog" aria-modal="true" aria-label="@T.ChooseFolder" @onclick:stopPropagation>
                <h2>@(Picker.IsMove ? T.MoveTo : T.CopyTo)</h2>
                <nav class="picker-crumbs">
                    @foreach (var (label, path) in Picker.Crumbs)
                    {
                        <button class="crumb-button" @onclick="() => Picker.NavigateAsync(path, Token)">@label</button>
                        <span class="crumb-sep">›</span>
                    }
                </nav>
                <div class="picker-list">
                    @if (Picker.State == ListState.Loading)
                    {
                        <div class="list-note">@T.Loading</div>
                    }
                    else if (Picker.Folders.Count == 0)
                    {
                        <div class="list-note">@T.NoSubfolders</div>
                    }
                    @foreach (var folder in Picker.Folders.Where(f => !Picker.IsHidden(f)))
                    {
                        <button class="picker-folder" @onclick="() => Picker.NavigateAsync(folder.Path, Token)">
                            <FileIcon Folder="true" Name="" /><span class="name">@folder.Name</span><span class="submenu-arrow">›</span>
                        </button>
                    }
                </div>
                @if (Picker.Message is { } pickerMessage)
                {
                    <div class="dialog-error" role="alert">@pickerMessage</div>
                }
                <div class="dialog-buttons">
                    <button type="button" @onclick="Picker.Close">@T.Cancel</button>
                    <button type="button" class="primary" disabled="@(!Picker.CanPlaceHere)" @onclick="ConfirmPickerAsync">@(Picker.IsMove ? T.MoveHere : T.CopyHere)</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <Toast Model="Picker" />
    }

    @if (_infoItem is { } info)
    {
        <div class="backdrop" @onclick="() => _infoItem = null">
            <div class="dialog info-dialog" role="dialog" aria-modal="true" aria-label="@T.Information" @onclick:stopPropagation>
                <h2><FileIcon Folder="info.IsFolder" Name="@info.Name" /> @info.Name</h2>
                <dl class="info-list">
                    <dt>@T.KindLabel</dt>
                    <dd>@(info.IsFolder ? T.FolderKind : string.Format(CultureInfo.CurrentCulture, T.FileKind, System.IO.Path.GetExtension(info.Name).TrimStart('.').ToUpperInvariant()))</dd>
                    @if (!info.IsFolder)
                    {
                        <dt>@T.Size</dt>
                        <dd>@WebTexts.FormatSize(info.Size)@(info.Size >= 1024 ? $" ({info.Size.ToString("N0", CultureInfo.CurrentCulture)} B)" : string.Empty)</dd>
                    }
                    <dt>@T.Location</dt>
                    <dd>@(Browser.Space is { } infoSpace ? Browser.SpaceLabel(infoSpace) : string.Empty)/@info.Path</dd>
                    <dt>@T.ModifiedTime</dt>
                    <dd>@info.Modified.ToLocalTime().ToString("F", CultureInfo.CurrentCulture)</dd>
                </dl>
                <div class="dialog-buttons">
                    <button type="button" class="primary" @onclick="() => _infoItem = null">@T.Close</button>
                </div>
            </div>
        </div>
    }

    @if (_dialog is Dialog.NewFolder or Dialog.Rename)
    {
        <div class="backdrop">
            <form class="dialog" @onsubmit="SubmitNameAsync" @onsubmit:preventDefault @onclick:stopPropagation>
                <h2>@(_dialog == Dialog.NewFolder ? T.NewFolder : T.Rename)</h2>
                <label>
                    <span>@T.Name</span>
                    <input @ref="_nameInput" @bind="_name" @bind:event="oninput" disabled="@_busy" />
                </label>
                @if (Browser.Message is { } problem)
                {
                    <div class="dialog-error" role="alert">@problem</div>
                }
                <div class="dialog-buttons">
                    <button type="button" disabled="@_busy" @onclick="CloseDialog">@T.Cancel</button>
                    <button type="submit" class="primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_name))">@T.Ok</button>
                </div>
            </form>
        </div>
    }
    else if (_dialog == Dialog.Delete)
    {
        <div class="backdrop">
            <div class="dialog" @onclick:stopPropagation>
                <h2>@T.Delete</h2>
                <p>@Browser.DeleteQuestion</p>
                <div class="dialog-buttons">
                    <button disabled="@_busy" @onclick="CloseDialog">@T.Cancel</button>
                    <button class="primary danger" disabled="@_busy" @onclick="DeleteAsync">@T.Delete</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <Toast Model="Browser" />
    }

    @if (Browser.Space is { } viewerSpace)
    {
        <FileViewer Space="viewerSpace" ImageUrl="@_imageUrl" OnClose="() => _focusList = true" />
    }

    @if (Browser.Uploads.Count > 0)
    {
        <div class="uploads">
            @foreach (var upload in Browser.Uploads)
            {
                <div class="upload">
                    <span>@string.Format(CultureInfo.CurrentCulture, T.Uploading, upload.Name)</span>
                    <progress max="@Math.Max(upload.Size, 1)" value="@upload.Sent"></progress>
                </div>
            }
        </div>
    }
</div>

@code {
    private enum Dialog
    {
        None,
        NewFolder,
        Rename,
        Delete,
    }

    private Dialog _dialog;
    private DriveItem? _contextItem;
    private double _menuX;
    private double _menuY;
    private const string FilesInputId = "upload-files";
    private const string FolderInputId = "upload-folder";

    private bool _createOpen;
    private InputFile? _folderInput;
    private bool _labelsOpen;
    private bool _contextLabels;
    private bool _dragging;
    private bool _busy;
    private string _name = string.Empty;
    private ElementReference _nameInput;
    private bool _focusName;
    private ElementReference _list;
    private bool _focusList;

    [Parameter]
    public CancellationToken Token { get; set; }

    /// <summary>„Versionen“ einer Datei; der Dialog gehört zum Rahmen, weil ihn auch Suche und „Zuletzt“ öffnen.</summary>
    [Parameter]
    public EventCallback<DriveItem> OnShowVersions { get; set; }

    /// <summary>„Neues Label“ aus einem Label-Menü; der Dialog gehört zum Rahmen, weil ihn auch „My Labels“ öffnet.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<LocatedItem>> OnNewLabel { get; set; }

    /// <summary>Freigabedialog; wie Versionen gehört er zum Rahmen.</summary>
    [Parameter]
    public EventCallback<DriveItem> OnShare { get; set; }

    [Parameter]
    public EventCallback<DriveItem> OnRequestFiles { get; set; }

    private async Task ShareAsync(EventCallback<DriveItem> action, DriveItem item)
    {
        CloseMenus();
        await action.InvokeAsync(item);
    }

    private WebTexts T => Browser.Texts;

    private DriveItem? SingleFile => Browser.SelectedItems is [{ IsFolder: false } only] ? only : null;

    protected override void OnInitialized()
    {
        Browser.Changed += Refresh;
        Marks.Changed += Refresh;
        Picker.Changed += Refresh;
    }

    /// <summary>Stern in der Zeile: nur dieses Element, die Auswahl bleibt.</summary>
    private Task StarAsync(DriveItem item) => Marks.ToggleStarAsync([new LocatedItem(Browser.Space!, item)], Token);

    private async Task ToggleSelectionStarAsync()
    {
        var items = Browser.SelectedLocated;
        CloseMenus();
        await Marks.ToggleStarAsync(items, Token);
    }

    private bool _moreOpen;
    private DriveItem? _infoItem;

    private void ToggleMore()
    {
        var open = !_moreOpen;
        CloseMenus();
        _moreOpen = open;
    }

    /// <summary>„Kopieren nach …“ / „Verschieben nach …“ für die Auswahl; Start im aktuellen Ordner.</summary>
    private async Task OpenPickerAsync(bool move)
    {
        var items = Browser.SelectedItems;
        CloseMenus();
        if (Browser.Space is { } space && items.Count > 0)
        {
            await Picker.OpenAsync(space, Browser.Path, items, move, Browser.SpaceLabel(space), Token);
        }
    }

    private async Task ConfirmPickerAsync()
    {
        if (await Picker.ConfirmAsync(Token))
        {
            await Browser.LoadAsync(Token);
            _focusList = true;
        }
    }

    private void ShowInfo(DriveItem item)
    {
        CloseMenus();
        _infoItem = item;
    }

    private void ToggleLabels()
    {
        var open = !_labelsOpen;
        CloseMenus();
        _labelsOpen = open;
    }

    private async Task NewLabelAsync(IReadOnlyList<LocatedItem> items)
    {
        CloseMenus();
        await OnNewLabel.InvokeAsync(items);
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Der Cursor steht sofort im Namensfeld (autofocus greift bei nachträglich eingefügten Dialogen nicht); nach dem Dialog
    /// geht der Fokus zurück in die Liste, damit Entf, F2 und Pfeile weiter wirken.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusName)
        {
            _focusName = false;
            await _nameInput.FocusAsync();
        }
        else if (_focusList)
        {
            _focusList = false;
            await _list.FocusAsync(preventScroll: true);
        }
    }

    private string Arrow(SortColumn column) => Browser.Sort != column ? string.Empty : Browser.Descending ? "▼" : "▲";

    /// <summary>
    /// Doppelklick oder „Öffnen“: Ordner betreten; Bilder, PDF, Text, Markdown, RTF und DOCX im Betrachter zeigen; alles andere
    /// herunterladen.
    /// </summary>
    private async Task OpenItemAsync(DriveItem item)
    {
        CloseMenus();
        if (item.IsFolder)
        {
            await Browser.OpenAsync(item, Token);
            return;
        }

        _imageUrl = Browser.ThumbnailUrl(item, large: true);
        var kind = ViewerViewModel.KindOf(item);
        if (kind == ViewerKind.None || (kind == ViewerKind.Image && _imageUrl is null))
        {
            await Js.InvokeVoidAsync("syncDrive.download", Browser.DownloadUrl(item), item.Name);
            return;
        }

        await Viewer.OpenAsync(Browser.Space!, item, Token);
    }

    private string? _imageUrl;

    private async Task ShowVersionsAsync(DriveItem item)
    {
        CloseMenus();
        await OnShowVersions.InvokeAsync(item);
    }

    private void ShowContextMenu(MouseEventArgs e, DriveItem item)
    {
        Browser.SelectForContextMenu(item);
        _contextItem = item;
        _menuX = e.ClientX;
        _menuY = e.ClientY;
        _createOpen = _labelsOpen = _contextLabels = _moreOpen = false;
    }

    private void CloseMenus()
    {
        _contextItem = null;
        _createOpen = false;
        _labelsOpen = false;
        _contextLabels = false;
        _moreOpen = false;
    }

    private void ToggleCreate()
    {
        var open = !_createOpen;
        CloseMenus();
        _createOpen = open;
    }

    private void OpenDialog(Dialog dialog)
    {
        CloseMenus();
        Browser.DismissMessage();
        _name = dialog == Dialog.Rename && Browser.SelectedItems is [var item] ? item.Name : string.Empty;
        _dialog = dialog;
        _focusName = dialog is Dialog.NewFolder or Dialog.Rename;
    }

    private void CloseDialog()
    {
        _dialog = Dialog.None;
        _focusList = true;
        Browser.DismissMessage();
    }

    private async Task SubmitNameAsync()
    {
        _busy = true;
        var ok = _dialog == Dialog.NewFolder
            ? await Browser.CreateFolderAsync(_name, Token)
            : Browser.SelectedItems is [var item] && await Browser.RenameAsync(item, _name, Token);
        _busy = false;
        if (ok)
        {
            _dialog = Dialog.None; // sonst bleibt der Dialog mit der Meldung offen
            _focusList = true;
        }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        await Browser.DeleteSelectedAsync(Token);
        _busy = false;
        _dialog = Dialog.None;
        _focusList = true;
    }

    private void DragEnter(DragEventArgs e)
    {
        if (e.DataTransfer.Types.Contains("Files"))
        {
            _dragging = true;
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        _dragging = false;
        var files = e.GetMultipleFiles(int.MaxValue)
            .Select(f => new UploadFile(f.Name, f.Size, f.LastModified, () => f.OpenReadStream(long.MaxValue, Token)))
            .ToList();
        await Browser.UploadAsync(files, Token);
    }

    /// <summary>Blazor kennt nur den Dateinamen; den Pfad im gewählten Ordner liefert der Browser (webkitRelativePath).</summary>
    private async Task UploadFolderAsync(InputFileChangeEventArgs e)
    {
        var picked = e.GetMultipleFiles(int.MaxValue);
        var paths = await Js.InvokeAsync<string[]>("syncDrive.relativePaths", _folderInput!.Element);
        var files = picked
            .Select((f, i) => new UploadFile(i < paths.Length ? paths[i] : f.Name, f.Size, f.LastModified, () => f.OpenReadStream(long.MaxValue, Token)))
            .ToList();
        await Browser.UploadFolderAsync(files, Token);
    }

    /// <summary>Alt+C öffnet „Neu“; danach F (Ordner), U (Dateien) oder I (Ordner hochladen).</summary>
    private async Task CreateKeyAsync(KeyboardEventArgs e)
    {
        if (!Browser.CanWrite)
        {
            return;
        }

        if (e.AltKey && e.Key is "c" or "C")
        {
            ToggleCreate();
            return;
        }

        if (!_createOpen || e.AltKey || e.CtrlKey || e.MetaKey)
        {
            return;
        }

        switch (e.Key.ToUpperInvariant())
        {
            case "F":
                OpenDialog(Dialog.NewFolder);
                break;
            case "U":
                CloseMenus();
                await Js.InvokeVoidAsync("syncDrive.click", FilesInputId);
                break;
            case "I":
                CloseMenus();
                await Js.InvokeVoidAsync("syncDrive.click", FolderInputId);
                break;
        }
    }

    private string Shortcut(string key) => string.Format(CultureInfo.CurrentCulture, T.CreateShortcut, key);

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Delete" when Browser.CanWrite && Browser.Selected.Count > 0:
                OpenDialog(Dialog.Delete);
                break;
            case "F2" when Browser.CanWrite && Browser.Selected.Count == 1:
                OpenDialog(Dialog.Rename);
                break;
            case "Enter" when Browser.SelectedItems is [{ IsFolder: true } folder]:
                await Browser.OpenAsync(folder, Token);
                break;
            case "a" when e.CtrlKey || e.MetaKey:
                Browser.SelectAll();
                break;
            case "Escape":
                CloseMenus();
                Browser.ClearSelection();
                break;
            case "Backspace" when Browser.Breadcrumbs.Count > 1:
                await Browser.NavigateAsync(Browser.Breadcrumbs[^2].Path, Token);
                break;
        }
    }

    public void Dispose()
    {
        Browser.Changed -= Refresh;
        Marks.Changed -= Refresh;
        Picker.Changed -= Refresh;
    }
}
