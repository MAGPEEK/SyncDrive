<?xml version="1.0" encoding="utf-8"?>
<!--
  SyncDrive Client für Windows. Installation pro Benutzer nach %LOCALAPPDATA%\Programs\SyncDrive, ohne Administratorrechte (der Client
  läuft ohnehin je Benutzer: Daemon, Autostart und Explorer-Menü liegen unter HKCU). Benutzerdaten (%LOCALAPPDATA%\SyncDrive) bleiben bei
  der Deinstallation erhalten.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="SyncDrive Client" Manufacturer="SyncDrive" Version="$(var.ProductVersion)"
           UpgradeCode="955d9692-393e-4837-b59a-3a6915beba82" Scope="perUser" Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="syncdrive.ico" SourceFile="$(var.AppIcon)" />
    <Property Id="ARPPRODUCTICON" Value="syncdrive.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MAGPEEK/SyncDrive" />
    <!-- Nach der Installation starten; mit LAUNCHAPP=0 (z. B. bei Verteilung per Skript) nicht. -->
    <Property Id="LAUNCHAPP" Value="1" Secure="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="SyncDrive" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="Integration" Directory="INSTALLFOLDER">
      <!-- Ordner aufräumen, syncdrive_cli in den PATH, beim Entfernen Autostart und Explorer-Menü löschen (legt der Client selbst an). -->
      <Component Id="Integration">
        <RegistryValue Root="HKCU" Key="Software\SyncDrive\Installer" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" />
        <RemoveRegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="SyncDrive" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\*\shell\SyncDrive" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\SyncDrive" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\SyncDrive\Installer" Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut" Name="SyncDrive" Description="SyncDrive Client" Target="[INSTALLFOLDER]syncdrive.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="syncdrive.ico" />
        <RegistryValue Root="HKCU" Key="Software\SyncDrive\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="SyncDrive Client">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Integration" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Laufende Oberfläche und Daemon vor dem Ersetzen der Dateien beenden (Update, Deinstallation). -->
    <util:CloseApplication Id="CloseTray" Target="syncdrive.exe" CloseMessage="yes" TerminateProcess="1" RebootPrompt="no" />
    <util:CloseApplication Id="CloseDaemon" Target="syncdrive-daemon.exe" TerminateProcess="1" RebootPrompt="no" />

    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]syncdrive.exe&quot;" Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT REMOVE AND LAUNCHAPP = &quot;1&quot;" />
    </InstallExecuteSequence>

    <WixVariable Id="WixUILicenseRtf" Value="$(var.Assets)\License.rtf" />
    <ui:WixUI Id="WixUI_Minimal" />
  </Package>
</Wix>
