<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SyncDrive.Client.Tray.App"
             RequestedThemeVariant="Light">
  <!-- Tokens des Design-Systems „SyncDrive“ (Name dort in Klammern); Farben in den Fenstern nur über diese Schlüssel, nie als festen Wert. -->
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#0F8B8D" />            <!-- accent -->
    <SolidColorBrush x:Key="AccentHover" Color="#0B7577" />       <!-- accent-hover -->
    <SolidColorBrush x:Key="AccentLight" Color="#E4F2F2" />       <!-- accent-light -->
    <SolidColorBrush x:Key="AccentDisabled" Color="#9CCFD0" />    <!-- accent-disabled -->
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />          <!-- on-accent: Schrift auf accent und Abdunklung -->
    <SolidColorBrush x:Key="TextMain" Color="#2B2F33" />          <!-- text -->
    <SolidColorBrush x:Key="TextSub" Color="#7A8088" />           <!-- text-sub -->
    <SolidColorBrush x:Key="NavText" Color="#555B62" />           <!-- nav-text -->
    <SolidColorBrush x:Key="Line" Color="#E4E7EA" />              <!-- line -->
    <SolidColorBrush x:Key="OutlineBorder" Color="#C9CED3" />     <!-- outline-border -->
    <SolidColorBrush x:Key="Link" Color="#2F78D0" />              <!-- link -->
    <SolidColorBrush x:Key="Bg" Color="#FFFFFF" />                <!-- bg -->
    <SolidColorBrush x:Key="NavBack" Color="#F7F8F9" />           <!-- nav -->
    <SolidColorBrush x:Key="ErrorText" Color="#D64541" />         <!-- error -->
    <SolidColorBrush x:Key="SelectedRow" Color="#D3EBEB" />       <!-- selected-row: gewählte Listenzeile -->
    <SolidColorBrush x:Key="SelectedRowHover" Color="#C4E3E4" />  <!-- selected-row-hover -->
    <SolidColorBrush x:Key="IconDisc" Color="#3A4047" />          <!-- icon-disc: Kreis hinter den Symbolen im Assistenten -->
    <SolidColorBrush x:Key="Scrim" Color="#66000000" />           <!-- scrim: Abdunklung hinter Hinweisen über dem Fenster -->
    <!-- Fluent nutzt den Systemakzent für Optionsfelder, Kästchen, Fokus und Auswahl: auf die eigene Akzentfarbe legen -->
    <Color x:Key="SystemAccentColor">#0F8B8D</Color>
    <Color x:Key="SystemAccentColorDark1">#0D7B7D</Color>
    <Color x:Key="SystemAccentColorDark2">#0B6A6C</Color>
    <Color x:Key="SystemAccentColorDark3">#08595A</Color>
    <Color x:Key="SystemAccentColorLight1">#3AA3A5</Color>
    <Color x:Key="SystemAccentColorLight2">#6CBCBD</Color>
    <Color x:Key="SystemAccentColorLight3">#A3D6D7</Color>

    <!-- Symbole der Navigation (24×24, gefüllt, Aussparungen über EvenOdd); Farbe kommt aus Foreground des Knopfs -->
    <StreamGeometry x:Key="IconSyncTasks">M3.5 4H9L11 6H20.5A1.5 1.5 0 0 1 22 7.5V18.5A1.5 1.5 0 0 1 20.5 20H3.5A1.5 1.5 0 0 1 2 18.5V5.5A1.5 1.5 0 0 1 3.5 4Z M10 8.8L12.6 11.6H10.8V17H9.2V11.6H7.4Z M14 17.2L16.6 14.4H14.8V9H13.2V14.4H11.4Z</StreamGeometry>
    <StreamGeometry x:Key="IconLogs">M6.5 2H14L19 7V20.5A1.5 1.5 0 0 1 17.5 22H6.5A1.5 1.5 0 0 1 5 20.5V3.5A1.5 1.5 0 0 1 6.5 2Z M14 3V7.5H18.5Z M8 10.6H9.8V12.4H8Z M11 10.6H16V12.4H11Z M8 14.1H9.8V15.9H8Z M11 14.1H16V15.9H11Z M8 17.6H9.8V19.4H8Z M11 17.6H16V19.4H11Z</StreamGeometry>
    <StreamGeometry x:Key="IconNotifications">M12 2.5A1.5 1.5 0 0 1 13.5 4V4.6A6 6 0 0 1 18 10.5V15L20 17.5V18.5H4V17.5L6 15V10.5A6 6 0 0 1 10.5 4.6V4A1.5 1.5 0 0 1 12 2.5Z M9.7 19.5H14.3A2.3 2.3 0 0 1 9.7 19.5Z</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M3.5 4H9L11 6H20.5A1.5 1.5 0 0 1 22 7.5V18.5A1.5 1.5 0 0 1 20.5 20H3.5A1.5 1.5 0 0 1 2 18.5V5.5A1.5 1.5 0 0 1 3.5 4Z</StreamGeometry>
    <StreamGeometry x:Key="IconMenu">M3 4.9H21V7.3H3Z M3 10.8H21V13.2H3Z M3 16.7H21V19.1H3Z</StreamGeometry>
    <StreamGeometry x:Key="IconHelp">M12 2A10 10 0 1 1 12 22A10 10 0 1 1 12 2Z M12 4.2A7.8 7.8 0 1 0 12 19.8A7.8 7.8 0 1 0 12 4.2Z M10.8 15.8H13.2V18.2H10.8Z M8.6 9.4A3.4 3.4 0 1 1 13.6 12.4C12.9 12.8 13.1 13.2 13.1 14.4H10.9C10.9 12.6 11.1 11.9 12.4 11.1A1.3 1.3 0 1 0 10.7 9.4Z</StreamGeometry>
    <SolidColorBrush x:Key="FolderFill" Color="#F2B84B" />         <!-- filetype-folder -->
    <StreamGeometry x:Key="IconSettings">M19.55 12.86L22.02 14.4 20.78 17.38 17.95 16.73 16.73 17.95 17.38 20.78 14.4 22.02 12.86 19.55 11.14 19.55 9.6 22.02 6.62 20.78 7.27 17.95 6.05 16.73 3.22 17.38 1.98 14.4 4.45 12.86 4.45 11.14 1.98 9.6 3.22 6.62 6.05 7.27 7.27 6.05 6.62 3.22 9.6 1.98 11.14 4.45 12.86 4.45 14.4 1.98 17.38 3.22 16.73 6.05 17.95 7.27 20.78 6.62 22.02 9.6 19.55 11.14Z M15.3 12A3.3 3.3 0 1 0 8.7 12A3.3 3.3 0 1 0 15.3 12Z</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextMain}" />
      <Setter Property="Background" Value="{StaticResource Bg}" />
    </Style>

    <!-- Hauptknopf: Akzentfläche, weiße Schrift (Create, Weiter, OK) -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="16,6" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHover}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentDisabled}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    </Style>

    <!-- Nebenknöpfe: grau umrandet -->
    <Style Selector="Button.outline">
      <Setter Property="Background" Value="{StaticResource Bg}" />
      <Setter Property="BorderBrush" Value="{StaticResource OutlineBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="12,5" />
    </Style>

    <!-- Navigation links: aktiv = Akzentfläche, weiße Schrift -->
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource NavText}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="PathIcon.nav-icon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource NavText}" />
    </Style>
    <!-- Symbolknöpfe der Panel-Fußleiste: 17 px, kräftiges Grau, beim Darüberfahren eine helle Akzentfläche -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentLight}" />
    </Style>
    <Style Selector="PathIcon.tool-icon">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="Foreground" Value="{StaticResource NavText}" />
    </Style>
    <Style Selector="Button.tool:pointerover PathIcon.tool-icon">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Button.nav.active PathIcon.nav-icon">
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    </Style>

    <!-- Link: blau, ohne Rahmen (lokaler Pfad, Personen, Dateien) -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Link}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentHover}" />
    </Style>

    <!-- Reiter im Panel: Unterstrich beim aktiven -->
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextSub}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="Foreground" Value="{StaticResource TextMain}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <Style Selector="TextBlock.sub">
      <Setter Property="Foreground" Value="{StaticResource TextSub}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
    <Style Selector="TextBlock.columnHead">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{StaticResource ErrorText}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Reiter der Einstellungen: aktiver fett; Hover färbt türkis -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <!-- Auswahl in Listen: helle Akzenttönung statt kräftiger Fläche -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SelectedRow}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SelectedRowHover}" />
    </Style>

    <Style Selector="CheckBox, RadioButton">
      <Setter Property="Margin" Value="0,2" />
    </Style>
  </Application.Styles>
</Application>
